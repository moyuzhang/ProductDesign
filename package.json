{
  "name": "product-design-control-surface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first project control surface with read-only repository evidence collection and an MCP management server.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/node/server/index.js",
    "autostart:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-autostart.ps1",
    "mcp": "node dist/node/mcp/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.58",
    "@fastify/static": "10.1.3",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "13.0.3",
    "elkjs": "^0.11.1",
    "fastify": "5.12.1",
    "jszip": "^3.10.1",
    "lucide-react": "1.34.0",
    "mysql2": "^3.24.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "web-worker": "^1.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "jsdom": "^29.1.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
